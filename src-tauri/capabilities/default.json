{
  "identifier": "default",
  "description": "Main window capability",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-ask",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        }
      ]
    }
  ]
}
